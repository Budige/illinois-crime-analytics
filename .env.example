# Illinois Crime Analytics - Environment Configuration
# Copy this file to .env and fill in your actual values
# Never commit .env to version control!

# Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=illinois_crime
DB_USER=postgres
DB_PASSWORD=your_password_here

# Logging
LOG_LEVEL=INFO

# Optional: API Keys for future enhancements
# ISP_API_KEY=your_api_key_here
# POWERBI_API_KEY=your_powerbi_key
